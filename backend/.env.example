# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# ---- API server ----
PORT=8091

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flyblaster
DB_PASSWORD=change-me
DB_NAME=flyblaster

# ---- WAHA (WhatsApp HTTP API) ----
# Production: https://waha-project-waha.o7brj8.easypanel.host
# Local dev : http://localhost:3000 (isolated local WAHA container)
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=change-me

# ---- Auth ----
# First-boot admin account. Change the password immediately after first login.
ADMIN_EMAIL=admin@flyblaster.local
ADMIN_PASSWORD=change-me

# Must be a long random string (e.g. `openssl rand -hex 32`).
# Anyone with this value can forge valid login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# ---- CORS ----
# Comma-separated list of allowed frontend origins. Avoid "*" in production.
FRONTEND_ORIGIN=http://localhost:8090
