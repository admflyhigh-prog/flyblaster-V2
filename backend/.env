# Fly Blaster local backend configuration
PORT=8091

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flyblaster

# WAHA (WhatsApp HTTP API)
WAHA_BASE_URL=http://150.109.5.90:3000
